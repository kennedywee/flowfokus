{
  "name": "@flowfokus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated Flowfokus API types and typed fetch client.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "bun run --cwd ../.. contract:types",
    "check:generated": "node ../../scripts/contract-types.mjs /tmp/flowfokus-schema.check.d.ts && diff -u src/schema.d.ts /tmp/flowfokus-schema.check.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
