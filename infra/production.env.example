# Do not use local demo credentials in production.
# Replace SHA with the commit from the candidate manifest after docker load.
HYDRAFLOW_SERVER_IMAGE=hydraflow-server:SHA
HYDRAFLOW_API_PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@DATABASE_HOST/hydraflow_production?sslmode=require
SECRET_KEY_BASE=REPLACE_WITH_BIN_RAILS_SECRET_OUTPUT
