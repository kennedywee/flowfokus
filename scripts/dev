#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/env.sh
docker compose up -d --wait db workos
export FLOWFOKUS_DEMO_MODE="${FLOWFOKUS_DEMO_MODE:-false}"
export FLOWFOKUS_DEMO_TOKEN="${FLOWFOKUS_DEMO_TOKEN:-flowfokus-local-demo-token}"
export WORKOS_CLIENT_ID="${WORKOS_CLIENT_ID:-client_flowfokus_local}"
export WORKOS_ISSUER="${WORKOS_ISSUER:-http://localhost:4100/user_management/client_flowfokus_local}"
export WORKOS_JWKS_URL="${WORKOS_JWKS_URL:-http://127.0.0.1:4100/sso/jwks/client_flowfokus_local}"
export WORKOS_API_KEY="${WORKOS_API_KEY:-sk_test_default}"
export WORKOS_API_BASE_URL="${WORKOS_API_BASE_URL:-http://127.0.0.1:4100}"
export WORKER_SECRET="${WORKER_SECRET:-local-host-worker-secret-not-for-production}"
export WORKOS_WEBHOOK_SECRET="${WORKOS_WEBHOOK_SECRET:-whsec_flowfokus_local_only}"
export RAILS_DEVELOPMENT_HOSTS="host.docker.internal${RAILS_DEVELOPMENT_HOSTS:+,$RAILS_DEVELOPMENT_HOSTS}"
node scripts/configure-workos-webhook.mjs http://host.docker.internal:4000/webhooks/workos

set -m
pids=()
cleanup() {
  trap - EXIT INT TERM
  for pid in "${pids[@]}"; do
    kill -- "-$pid" 2>/dev/null || true
  done
  wait || true
}
trap cleanup EXIT INT TERM

# The emulator container reaches Rails through the Docker host gateway.
(cd apps/server && exec bin/dev -b 0.0.0.0 -p 4000) &
pids+=("$!")
bun run --cwd apps/portal dev &
pids+=("$!")
bun run --cwd apps/site dev &
pids+=("$!")
echo "Portal: http://localhost:4001 | Gym: http://chainsaw.localhost:4002"
wait -n "${pids[@]}"
