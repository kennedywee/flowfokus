#!/usr/bin/env bash
# On a Boat machine: gives the staff portal and the sign-in emulator their Boat
# links and prints them. A link is an HTTPS address that opens on any device.
# Run it once the stack is up. Safe to run again: a link keeps its address.
#
# The portal's link is private: its _token is the access. The emulator's is
# public, so that sign-in can send any browser there. It holds fake users only.
set -euo pipefail

boat_host="$HOME/.ascii/host"
if [[ ! -x "$boat_host" ]]; then
  echo "Not a Boat machine: no links. Use http://localhost:4001." >&2
  exit 0
fi

link() {
  local port="$1" access="$2" addresses
  addresses="$(ss -ltnH "sport = :$port" | awk '{print $4}')"
  if [[ -z "$addresses" ]]; then
    echo "Nothing listens on port $port yet. Start the stack first." >&2
    return 1
  fi
  # A service on every address (0.0.0.0, [::], or *) gets a direct link. One
  # on loopback only needs Boat's relay. The relay listens on the machine's
  # other addresses one by one, never on a wildcard, so a second run still
  # sees a loopback service and keeps the relay.
  if grep -qE '^(0\.0\.0\.0|\[::\]|\*):' <<<"$addresses"; then
    "$boat_host" url "$port" "$access"
  else
    "$boat_host" url "$port" "$access" --localhost
  fi
}

# The machine's own tool still prints Boat's older domain. Both lead to the
# same place; sign-in accepts on.boat.dev.
current() { sed 's/\.on\.ascii\.dev/.on.boat.dev/'; }

emulator="$(link 4100 --public | current)"
portal="$(link 4001 --private | current)"
echo "Sign-in emulator: $emulator"
echo "Staff portal:     $portal"
