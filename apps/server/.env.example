# Rails API environment. Copy to .env only for tools that read it; Rails does not load .env.
# Local defaults match compose.yaml at the repository root.

DATABASE_URL=postgres://hydraflow:hydraflow@127.0.0.1:54329/hydraflow_development
TEST_DATABASE_URL=postgres://hydraflow:hydraflow@127.0.0.1:54329/hydraflow_test

# Local demo authentication. Development and test only.
# Rails refuses to boot with HYDRAFLOW_DEMO_MODE=true in production.
HYDRAFLOW_DEMO_MODE=true
HYDRAFLOW_DEMO_TOKEN=hydraflow-local-demo-token

# WorkOS. Setting WORKOS_CLIENT_ID makes non-demo tokens fail closed with
# 503 auth_unavailable until JWT/JWKS verification ships (next sprint).
# WORKOS_CLIENT_ID=

# Production only.
# RAILS_ENV=production
# SECRET_KEY_BASE=   # output of bin/rails secret
# RAILS_MAX_THREADS=5
# PORT=3000
