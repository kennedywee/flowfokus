# Local development only. Copy to .dev.vars. Never commit .dev.vars.
# The site calls /public/* without a credential, and /member/* with the
# signed-in member's token from the session cookie.
API_BASE_URL=http://127.0.0.1:4000

# Member sign-in through WorkOS Emulate (docker compose up -d workos).
# Remove these lines to see the "sign-in is turned off" state.
WORKOS_CLIENT_ID=client_flowfokus_local
WORKOS_API_KEY=sk_test_default
WORKOS_REDIRECT_URI=http://chainsaw.localhost:4002/callback
WORKOS_COOKIE_PASSWORD=local-only-site-cookie-password-0123456789abcdef
WORKOS_API_HOSTNAME=localhost
WORKOS_API_PORT=4100
WORKOS_API_HTTPS=false
WORKOS_BROWSER_URL=http://localhost:4100
