# Local development only. Production must not use these demo values.
DATABASE_URL=postgres://flowfokus:flowfokus@127.0.0.1:54329/flowfokus_development
TEST_DATABASE_URL=postgres://flowfokus:flowfokus@127.0.0.1:54329/flowfokus_test
FLOWFOKUS_DB_PORT=54329
FLOWFOKUS_DEMO_MODE=false
FLOWFOKUS_DEMO_TOKEN=flowfokus-local-demo-token
# For access from another device, add this host's Tailscale IP to this list.
# Set the emulator bind IP to 0.0.0.0 to keep localhost and remote access available.
FLOWFOKUS_DEV_AUTH_HOSTS=localhost,127.0.0.1
FLOWFOKUS_WORKOS_BIND_IP=127.0.0.1
API_BASE_URL=http://127.0.0.1:4000
WORKOS_CLIENT_ID=client_flowfokus_local
WORKOS_ISSUER=http://localhost:4100/user_management/client_flowfokus_local
WORKOS_JWKS_URL=http://127.0.0.1:4100/sso/jwks/client_flowfokus_local
